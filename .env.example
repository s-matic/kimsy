# Supabase is not used by the local-first product slice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for AI onboarding, document/image interpretation, and assessment chat.
# The sample workspace remains available without a key.
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL is the shared default. Either agent can override it independently.
OPENAI_MODEL=gpt-5.4-nano
AI_SETUP_MODEL=
AI_ASSESSMENT_MODEL=
