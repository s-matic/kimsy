# The app runs with seeded local data when Supabase variables are absent.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The deterministic provider is used when OPENAI_API_KEY is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Optional transactional notification adapter.
RESEND_API_KEY=
EMAIL_FROM=Kimsy <notifications@example.com>
